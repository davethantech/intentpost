NODE_ENV=production
POSTGRES_USER=intentpost
POSTGRES_PASSWORD=GENERATE_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=intentpost
DATABASE_URL=postgres://intentpost:GENERATE_A_STRONG_DATABASE_PASSWORD@db:5432/intentpost
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
PGSSL=false
JWT_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=intentpost
JWT_AUDIENCE=intentpost-api
ACCESS_TTL=15m
CORS_ORIGINS=https://app.example.com
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
APP_BASE_URL=https://app.example.com
FULFILLMENT_PROVIDER=mock
ENABLE_LIVE_FULFILLMENT=false
WEBHOOK_SECRET_DEFAULT=GENERATE_A_UNIQUE_WEBHOOK_SECRET
TRUST_PROXY=1
WORKER_POLL_MS=1000
